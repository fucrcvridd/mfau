# Скопируйте в .env:  cp .env.example .env
HTTP_ADDR=:8080

# Вариант 1 (по умолчанию): Postgres из docker-compose (make db-up)
DATABASE_URL=postgres://dental:dental@localhost:5433/dental_crm?sslmode=disable

# Вариант 2: свой локальный Postgres на порту 5432 (раскомментируйте и подставьте своего пользователя)
# DATABASE_URL=postgres://YOUR_USER@localhost:5432/dental_crm?sslmode=disable
